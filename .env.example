# Copie para .env.local e preencha. Nunca faça commit do .env.local.

# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xdhjlunvgtuxwjqsvqzj.supabase.co
# Chave pública (anon/publishable). Pode ir ao navegador; o acesso é limitado por RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave secreta (service_role/secret). SÓ no servidor. Usada apenas pelas rotas /api/hermes.
SUPABASE_SERVICE_ROLE_KEY=

# Endereço público do painel (usado no link de recuperação de senha).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
