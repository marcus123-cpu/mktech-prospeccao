# Copie para envio/.env (fica fora do Git) e preencha.
# Endereço do painel (o da Vercel ou http://localhost:3000)
MKTECH_CRM_URL=https://mktech-prospeccao.vercel.app
# Token do enviador: crie na tela "Envio automático" do painel
MKTECH_ENVIO_TOKEN=

# --- WhatsApp Business Cloud API (transporte "whatsapp"), número separado de prospecção ---
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
# Modelo aprovado pela Meta (veja envio/WHATSAPP-META.md)
WHATSAPP_TEMPLATE_NAME=mktech_primeiro_contato
WHATSAPP_TEMPLATE_LANG=pt_BR
# Teste: só envia para estes números (separe por vírgula). Deixe vazio só depois da aprovação por escrito.
ENVIO_SO_PARA=5517992250729
